#!/bin/sh
#Richard H. Tingstad
set -e

# Package given files (to stdout)
# Writes temp files "$file".gz, "$file.deflate", and "table"
main() {
    offset=0
    > table

    for file; do

    modtime=$(dosTime "$file" || epochToDosTime "$(date +%s)" \
        || printf '00 00 00 00')
    sizeuncom=$(printf %x $(wc -c "$file" | awk '{print $1}') | littleEndInt)
    gzip -c < "$file" > "$file".gz

    crc=$(tail -c8 < "$file.gz" | head -c4 | od -An -tx1 -v)

    filename=$file
    name=$(printf %s "$filename" | od -An -tx1 -v)
    namelen=$(printf '%02x 00' ${#filename}) # assume < 256

    # gzip is 10-byte header (+optional) + deflate stream + 8-byte trailer
    streamlen=$(( $(wc -c "$file.gz" | awk '{print $1}') - 10 - 8 ))

    dd bs=1 skip=10 < "$file.gz" 2>/dev/null \
        | dd bs=1 count=$streamlen 2>/dev/null > "$file.deflate"

    sizecompr=$(printf %x $streamlen | littleEndInt)

    put 50 4b 03 04 # PK0304 local file header signature  (0x04034b50)
    put 14 00       # version needed to extract
    put 00 00       # general purpose bit flag
    put 08 00       # compression method
    put $modtime    # last mod file time + date     2+2 bytes
    put $crc        # crc-32                          4 bytes
    put $sizecompr  # compressed size                 4 bytes
    put $sizeuncom  # uncompressed size               4 bytes
    put $namelen    # file name length                2 bytes
    put 00 00       # extra field length              2 bytes
    put $name       # file name (variable size)

    cat "$file.deflate"

    { printf '%s\t' "$crc" "$sizecompr" "$sizeuncom" "$namelen" \
        "$(printf %x "$offset" | littleEndInt)" "$modtime" "$name"
      printf '\n'; } >> table

    headerlen=$(( 30 + ${#filename} ))
    offset=$(( offset + headerlen + streamlen ))

    done
    i=0 dirlen=0
    for filename; do
    i=$(( i + 1 ))

    IFS="$tab" read crc sizecompr sizeuncom namelen localoff modtime name <<-EOF
	$(awk "NR == $i" < table)
	EOF

    put 50 4b 01 02  # PK0102 central file header signature  (0x02014b50)
    put 1e 03        # version made by                 2 bytes
    put 14 00        # version needed to extract       2 bytes
    put 00 00        # general purpose bit flag        2 bytes
    put 08 00        # compression method              2 bytes
    put $modtime     # last mod file time + date     2+2 bytes
    put $crc         # crc-32                          4 bytes
    put $sizecompr   # compressed size                 4 bytes
    put $sizeuncom   # uncompressed size               4 bytes
    put $namelen     # file name length                2 bytes
    put 00 00        # extra field length              2 bytes
    put 00 00        # file comment length             2 bytes
    put 00 00        # disk number start               2 bytes
    put 01 00        # internal file attributes        2 bytes
    put 00 00 a4 81  # external file attributes        4 bytes
    put $localoff    # relative offset of local header 4 bytes
    put $name        # file name (variable size)
                     # extra field (variable size)
                     # file comment (variable size)

    dirlen=$(( dirlen + 46 + ${#filename} ))

    rm "$filename.gz" "$filename.deflate"
    done

    numb=$(printf %02x $#)
    dirs=$(printf %x $dirlen | littleEndInt)
    offs=$(printf %x $offset | littleEndInt)

    put 50 4b 05 06  # PK0506 end of central dir signature  (0x06054b50)
    put 00 00        # number of this disk             2 bytes
    put 00 00        # number of the disk with the start of the central dir
    put $numb 00     # total number of entries in the central dir on this disk
    put $numb 00     # total number of entries in the central directory
    put $dirs        # size of the central directory   4 bytes
    put $offs        # offset of start of central dir w/respect to starting disk
    put 00 00        # .ZIP file comment length        2 bytes
                     # .ZIP file comment       (variable size)

    rm table
}

put() {
    for arg; do
        printf \\$(printf %03o 0x$arg)
    done
}

# Emit "tlo thi dlo dhi" hex bytes: MS-DOS time & date of file's mtime (UTC)
dosTime() {
    octal=$(tar cf - "$1" 2>/dev/null \
        | dd bs=1 skip=136 count=11 2>/dev/null \
        | tr -cd '0-7')
    [ -n "$octal" ] || return 1
    epoch=$(awk -v oct="$octal" 'BEGIN {
        ep = 0
        for (i = 1; i <= length(oct); i++) ep = ep*8 + substr(oct,i,1)+0
        print ep
    }')
    epochToDosTime "$epoch"
}

# Emit "tlo thi dlo dhi" hex bytes: MS-DOS time & date from epoch seconds (UTC)
epochToDosTime() {
    awk -v ep="$1" 'BEGIN {
        sec  = ep % 60; ep = int(ep/60)
        min  = ep % 60; ep = int(ep/60)
        hour = ep % 24; days = int(ep/24)
        year = 1970
        while (1) {
            yd = ((year%4==0 && year%100!=0) || year%400==0) ? 366 : 365
            if (days < yd) break
            days -= yd; year++
        }
        split("31 28 31 30 31 30 31 31 30 31 30 31", dm)
        if ((year%4==0 && year%100!=0) || year%400==0) dm[2] = 29
        month = 1
        while (days >= dm[month]) { days -= dm[month]; month++ }
        day = days + 1
        if (year < 1980) { year=1980; month=1; day=1; hour=0; min=0; sec=0 }
        dt = (year-1980)*512 + month*32 + day
        tm = hour*2048 + min*32 + int(sec/2)
        printf "%02x %02x %02x %02x\n",
            tm%256, int(tm/256), dt%256, int(dt/256)
    }' | grep \
        '^[0-9a-f][0-9a-f] [0-9a-f][0-9a-f] [0-9a-f][0-9a-f] [0-9a-f][0-9a-f]$'
}

# 32 bit (4 byte) little endian integer from hex
# or from decimal argument
littleEndInt() {
    if [ $# -gt 0 ]; then
        printf %x $1 | littleEndInt
        return
    fi
    sed '
        :pad
        s/^.\{0,7\}$/0&/
        t pad
        s/../_&/g
        :rev
        s/^\(.*\)_\(..\) *\([^_]*\)$/\1\3 \2/
        t rev
    '
    # _aa_bb_cc_dd
    # _aa_bb_cc dd
    # _aa_bbdd cc
    # _aadd cc bb
    # dd cc bb aa
}

for bin in gzip od awk wc sed printf tail head dd tar tr; do
    command -v "$bin" >/dev/null 2>&1 || {
        echo "Missing required tool: $bin" >&2
        exit 1
    }
done

tab='	'

usage() {
    printf >&2 'Usage: %s FILE...\n' "$0"
    printf >&2 'Packages given files to stdout\n'
    printf >&2 'Richard H. Tingstad\n'
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

for arg; do
    if ! [ -e "$arg" ]; then
        printf >&2 'Not a file: "%s"\n' "$arg"
        usage
        exit 1
    fi
done

main "$@"

