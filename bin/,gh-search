#!/bin/sh
set -e

if [ -z "$GITHUB_TOKEN" ]; then
    echo "GITHUB_TOKEN not set, maybe create one:"
    echo "https://github.com/settings/personal-access-tokens"
    exit 1
fi

q=$(,urlencode "$@")

name=gh-search-res-$q-$(date +%Y-%m-%d.%H:%M:%S)

curl -L \
  -H "User-Agent: tingstad" \
  -H "Authorization: Bearer $GITHUB_TOKEN" \
  -H "X-GitHub-Api-Version: 2026-03-10" \
  -H "Accept: application/vnd.github.v3.text-match+json" \
  "https://api.github.com/search/code?q=$q&per_page=100" \
  | tee "$name.json" \
  | jq -r '.items[] |
    [ .repository.full_name, .path, .text_matches[0].fragment ] | @tsv' \
    | tee "$name.tsv"

